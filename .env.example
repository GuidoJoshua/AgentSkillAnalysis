# Copy to .env next to docker/compose.yaml (docker/.env) and pick one preset.
# Presets per GPU setup are listed in configs/models.yaml.

# Personal server: RTX 3090 24GB x1
MODEL=Qwen/Qwen3-8B
VLLM_TAG=v0.11.0
TP=1
MAX_MODEL_LEN=32768
GPU_UTIL=0.90
TOOL_PARSER=hermes
SERVED_NAME=agent

# HF_TOKEN=
# HF_CACHE=~/.cache/huggingface

# Driver on the personal server is CUDA 12.7 (image wants 12.8)
NVIDIA_DISABLE_REQUIRE=1
